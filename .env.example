# Server Configuration
PORT=8085
NODE_ENV=development

# Session Secret (change this to a random string)
SESSION_SECRET=change_this_to_a_random_secret

# Auth0 Configuration
# Get these from https://manage.auth0.com
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here

# Stripe Configuration (TEST KEYS ONLY)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# MongoDB Configuration
# Use MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/barkerperformance?retryWrites=true&w=majority

# Nodemailer Configuration (Gmail)
# Use app-specific password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Session Configuration
SESSION_SAVE_UNINITIALIZED=true
SESSION_RESAVE=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE=86400000

# Production-only (uncomment and set in production)
# ALLOWED_ORIGIN=https://yourdomain.com
